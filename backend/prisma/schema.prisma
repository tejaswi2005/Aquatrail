// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  DRIVER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  STARTED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  STARTED
  COMPLETED
  CANCELLED
}

enum InventoryTransactionType {
  RESTOCK
  ORDER_RESERVED
  ORDER_RELEASED
  ADJUSTMENT
}

enum SubscriptionPackageType {
  DAILY
  ALTERNATE_DAY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum DeliveryTimePreference {
  MORNING
  AFTERNOON
  EVENING
}

enum SubscriptionOccurrenceStatus {
  PENDING
  GENERATED
  FAILED
  CANCELLED
}

enum NotificationType {
  SUBSCRIPTION_CONFIRMED
  DELIVERY_STARTED
  DELIVERY_COMPLETED
  DELIVERY_CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile CustomerProfile?
  driverProfile   DriverProfile?

  @@index([role])
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses     Address[]
  orders        Order[]
  subscriptions Subscription[]
}

model DriverProfile {
  id            String             @id @default(cuid())
  userId        String             @unique
  licenseNumber String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
  subscriptionAssignments SubscriptionDriverAssignment[]
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders        Order[]
  subscriptions Subscription[]

  @@index([customerId])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  description      String?
  bottleSizeLiters Float
  pricePaise       Int
  stockQuantity    Int      @default(0)
  isActive         Boolean  @default(true)
  imageUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]
  subscriptions         Subscription[]

  @@index([isActive])
}

model InventoryTransaction {
  id        String                   @id @default(cuid())
  productId String
  orderId   String?
  type      InventoryTransactionType
  quantity  Int
  note      String?
  createdAt DateTime                 @default(now())

  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId, productId, type])
  @@index([productId, createdAt])
}

model Order {
  id                       String      @id @default(cuid())
  orderNumber              String      @unique
  customerId               String
  addressId                String
  subscriptionOccurrenceId String?     @unique
  status                   OrderStatus @default(PENDING)
  totalAmountPaise         Int
  notes                    String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  customer               CustomerProfile         @relation(fields: [customerId], references: [id])
  address                Address                 @relation(fields: [addressId], references: [id])
  items                  OrderItem[]
  delivery               Delivery?
  subscriptionOccurrence SubscriptionOccurrence? @relation(fields: [subscriptionOccurrenceId], references: [id], onDelete: SetNull)
  inventoryTransactions  InventoryTransaction[]
  notifications          Notification[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPricePaise Int
  subtotalPaise  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
}

model Subscription {
  id                                 String                  @id @default(cuid())
  customerId                         String
  productId                          String
  addressId                          String
  packageType                        SubscriptionPackageType
  quantityPerDelivery                Int
  startDate                          DateTime                @db.Date
  endDate                            DateTime?               @db.Date
  nextDeliveryDate                   DateTime                @db.Date
  deliveryTimePreference             DeliveryTimePreference
  status                             SubscriptionStatus      @default(ACTIVE)
  unitPricePaise                     Int
  idempotencyKey                     String?                 @unique
  createdAt                          DateTime                @default(now())
  updatedAt                          DateTime                @updatedAt

  customer    CustomerProfile          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  address     Address                  @relation(fields: [addressId], references: [id], onDelete: Restrict)
  occurrences SubscriptionOccurrence[]
  driverAssignments SubscriptionDriverAssignment[]
  notifications Notification[]

  @@index([customerId, status])
  @@index([status, nextDeliveryDate])
}

model SubscriptionOccurrence {
  id             String                       @id @default(cuid())
  subscriptionId String
  scheduledAt    DateTime                     @db.Timestamptz(3)
  status         SubscriptionOccurrenceStatus @default(PENDING)
  failureReason  String?
  attemptCount   Int                          @default(0)
  lastAttemptAt  DateTime?
  generatedAt    DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  order        Order?

  @@unique([subscriptionId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([subscriptionId, scheduledAt])
}

model SubscriptionDriverAssignment {
  id             String                @id @default(cuid())
  subscriptionId String
  driverId       String
  startDate      DateTime              @db.Date
  endDate        DateTime              @db.Date
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  driver       DriverProfile @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, startDate, endDate])
  @@index([driverId, startDate, endDate])
}

model Delivery {
  id                 String         @id @default(cuid())
  orderId            String         @unique
  driverId           String?
  status             DeliveryStatus @default(PENDING)
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver DriverProfile? @relation(fields: [driverId], references: [id])

  @@index([driverId, status])
}

model Notification {
  id                String             @id @default(cuid())
  eventKey          String             @unique
  type              NotificationType
  status            NotificationStatus @default(PENDING)
  orderId           String?
  subscriptionId    String?
  providerReference String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([orderId, type])
  @@index([subscriptionId, type])
}
