# Twilio SMS (server-only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
PUBLIC_APP_URL=

# Required for Indian production SMS. Register the sender, entity and each
# approved template with the relevant DLT platform before enabling this.
TWILIO_REQUIRE_DLT=true
TWILIO_DLT_ENTITY_ID=
TWILIO_DLT_TEMPLATE_ID_SUBSCRIPTION_CONFIRMED=
TWILIO_DLT_TEMPLATE_ID_DELIVERY_STARTED=
TWILIO_DLT_TEMPLATE_ID_DELIVERY_COMPLETED=
TWILIO_DLT_TEMPLATE_ID_DELIVERY_CANCELLED=
